# Server
PORT=8001

# Frontend origins allowed by CORS (exact match, comma of one each)
FRONTEND_URL=<your_frontend_url_here>
CLIENT_URL=<your_client_url_here>

# Database
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DB_NAME>?sslmode=require&channel_binding=require"

# Authentication
JWT_SECRET=<your_jwt_secret_here>

# AWS Config
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<your_aws_access_key_id_here>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key_here>
AWS_S3_BUCKET_NAME=<your_bucket_name_here>

# Redis / BullMQ
# Local docker compose: redis://localhost:6379
# Managed Redis with TLS: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
# Keep at 1 so the final READY/FAIL job cannot overtake earlier log batches.
LOG_WORKER_CONCURRENCY=1

# ECS Config
ECS_CLUSTER_ARN=<your_ecs_cluster_arn_here>
ECS_TASK_DEFINITION_ARN=<your_ecs_task_definition_arn_here>
AWS_VPC_SUBNETS=<your_vpc_subnet_ids_comma_separated>
AWS_SECURITY_GROUP=<your_security_group_id_here>

# ClickHouse
# Local docker compose: http://localhost:8123 (default user / clickhouse)
# Managed ClickHouse: https://<your_clickhouse_host_here>
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=default
