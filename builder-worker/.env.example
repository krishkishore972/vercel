# Shared with the API server. When the worker runs in docker-compose this is
# overridden to redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Local sandbox image built from ./build-server:
#   docker build -t vercel-builder:local ./build-server
BUILDER_IMAGE=vercel-builder:local

# Dedicated network with internet access but no connection to redis/clickhouse.
BUILDER_NETWORK=vercel-builds

# Build limits
BUILD_TIMEOUT_MS=840000
BUILDER_MEMORY_MB=3072
BUILDER_CPUS=1
BUILDER_PIDS_LIMIT=512
SHUTDOWN_TIMEOUT_MS=30000

# S3 upload credentials. These stay in the worker; the sandbox never sees them.
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=<your_aws_access_key_id_here>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key_here>
AWS_S3_BUCKET_NAME=<your_bucket_name_here>

# Optional log batching (defaults shown)
LOG_BATCH_SIZE=100
LOG_BATCH_MAX_BYTES=262144
LOG_FLUSH_INTERVAL_MS=250
