# Prisma database used to resolve subdomain -> project id
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DB_NAME>?sslmode=require&channel_binding=require"

# Public S3 origin for build artifacts. Use path-style because the bucket
# name contains a dot, which breaks the TLS wildcard for virtual-hosted URLs.
BASE_URL=https://s3.ap-south-2.amazonaws.com/vercel.kishore/__outputs
